<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <h1 class="mb-5">退会確認</h1>
            <div class="text-center">
                <p>本当に退会してもよろしいですか？</p>
            </div>
            <div class="d-flex gap-3">
                <%= link_to "退会しない", user_path(@user), class: "btn btn-secodary btn-lg" %>
                <%= link_to "退会する", withdraw_users_path, data: { turbo_method: :path, turbo_confirm: "本当に退会しますか？" }, class: "btn btn-danger btn-lg" %>
            </div>
        </div>
    </div>
</div>