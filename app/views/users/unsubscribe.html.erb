<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <h1 class="mb-5">退会確認</h1>
            <div class="text-center mt-5 pt-4">
                <p class="mb-4 fl-5">本当に退会してもよろしいですか？</p>
            </div>
            <div class="d-flex justify-content-center gap-4 mt-5 pt-5">
                <%= link_to "退会しない", user_path(@user), class: "btn btn-secondary btn-lg" %>
                <%= button_to "退会する", withdraw_user_path(@user), method: :patch, data: { turbo_confirm: "本当に退会しますか？" }, class: "btn btn-danger btn-lg" %>
            </div>
        </div>
    </div>
</div>