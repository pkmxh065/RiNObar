<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <h1 class="mb-5">User info</h1>
            <%= form_with model: @user do |f| %>
                <div class="mb-3">
                    <%= f.label :name, "Name", class: "form-label" %><br>
                    <%= f.text_field :name, class: "form-control w-100" %>
                </div>
                <div class="mb-3">
                    <%= f.label :image, "Profile image", class: "form-label" %><br>
                    <%= file_field :image, class: "form-control w-100" %>
                </div>
                <div class="mb-3">
                    <%= f.label :introduction, "Introduction", class: "form-label" %><br>
                    <%= f.text_area :introduction, class: "form-control w-100" %>
                </div>
                <div class="text-center mt-5">
                    <%= f.submit "Update", class: "btn btn-secondary btn-lg" %>
                    <%= link_to "Resign", "#", class: "btn btn-danger btn-lg" %>
                </div>
            <% end %>
        </div>
    </div>
</div>