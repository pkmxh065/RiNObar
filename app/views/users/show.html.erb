<div class="container">
    <div class="row">
        <div class="m-2">
            <h1>Users info</h1>
        </div>
        <div class="col-12 d-flex">
            <div class="col-lg-3">
                <div class="mt-2">
                    <% if @user.image.attached? %>
                        <%= image_tag @user.image, size: "300x300", class: "img-thumbnall mb-2" %>
                    <% else %>
                        <%= image_tag "no_image.png", size: "300x300" %>
                    <% end %>
                </div>
                <hr>
                <div class="d-flex justify-content-center mt-2">
                    <p><strong>user</strong></p>
                    <span class="ms-5"><%= @user.name %></span>
                </div>
                <div class="text-center">
                    <hr>
                    <p><strong>Introduction</strong></p>
                    <div class="mt-2"><%= @user.introduction %></div>
                </div>
                <div class="mt-2">
                    <%= link_to edit_user_path(@user), class: "btn btn-outline-secondary btn-block w-100" do %>
                        <i class="fas fa-user-cog"></i>
                    <% end %>
                </div>
            </div>
            <div class="col-lg-9 ps-md-5">
                <div class="row mt-5">
                    <div class="col-md-6 mb-4">
                        <%= link_to new_novel_path, class: "text-decoration-none text-dark h-100 d-block" do %>
                            <div class="border rounded p-4 text-center bg-light h-100 d-flex flex-column" style="min-height: 150px; display: flex; aligin-items:center; justify-content: center;">
                                <h3 class="text-nowrap" style="font-size: calc(1.2rem + 0.5vw);">Posts</h3><br>
                                <p class="text-nowrap mb-0" style="font-size: calc(0.6rem + 0.2vw);">—　投稿　—</p>
                            </div>
                        <% end %>
                    </div>
                    <div class="col-md-6 mb-4">
                        <%= link_to novels_path, class: "text-decoration-none text-dark h-100 d-block" do %>
                            <div class="border rounded p-4 text-center bg-light h-100 d-flex flex-column" style="min-height: 150px; display: flex; aligin-items:center; justify-content: center;">
                                <h3 class="text-nowrap" style="font-size: calc(1.2rem + 0.5vw);">Novels</h3><br>
                                <p class="text-nowrap mb-0" style="font-size: calc(0.6rem + 0.2vw);">—　ライトノベル　—</p>
                            </div>
                        <% end %>
                    </div>
                    <div class="col-md-6 mb-4">
                        <%= link_to "#", class: "text-decoration-none text-dark h-100 d-block" do %>
                            <div class="border rounded p-4 text-center bg-light h-100 d-flex flex-column" style="min-height: 150px; display: flex; aligin-items:center; justify-content: center;">
                                <h3 class="text-nowrap" style="font-size: calc(1.2rem + 0.5vw);">Favorite</h3><br>
                                <p class="text-nowrap mb-0" style="font-size: calc(0.6rem + 0.2vw);">—　お気に入り　―</p>
                            </div>
                        <% end %>
                    </div>
                    <div class="col-md-6 mb-4">
                        <%= link_to unsubscribe_user_path(@user), class: "text-decoration-none text-dark h-100 d-block" do %>
                            <div class="border rounded p-4 text-center bg-light h-100 d-flex flex-column" style="min-height: 150px; display: flex; aligin-items:center; justify-content: center;">
                                <h3 class="text-nowrap" style="font-size: calc(1.2rem + 0.5vw);">Leave</h3><br>
                                <p class="text-nowrap mb-0" style="font-size: calc(0.6rem + 0.2vw);">—　退会　—</p>
                            </div>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>