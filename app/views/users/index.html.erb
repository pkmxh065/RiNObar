<div class="container">
    <div class="row justify-content-center">
        <div class="m-5">
            <h1>Users</h1>
        </div>
        <div class="text-cetnter">
            <table class="table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% @users.each do |user| %>
                        <tr>
                            <td style="vertical-align: middle;">
                                <% if user.image.attached? %>
                                    <%= image_tag user.image, size: "200x200", class: "img-thumbnall mb-2" %>
                                <% else %>
                                    <%= image_tag "no_image.png", size: "200x200" %>
                                <% end %>
                            </td>
                            <td style="vertical-align: middle;"><%= user.name %></td>
                            <td style="vertical-align: middle;"><%= link_to "詳　細", user_path(user), class: "btn btn-info text-light" %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>