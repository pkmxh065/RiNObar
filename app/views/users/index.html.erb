<div class="container">
    <div class="row">
        <div class="m-5">
            <h1>Users</h1>
        </div>
        <div>
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% @users.each do %>
                        <tr>
                            <td>
                                <% if @user.image.attached? %>
                                    <%= image_tag @user.image, size: "300x300", class: "img-thumbnall mb-2" %>
                                <% else %>
                                    <%= image_tag "no_image.png", size: "300x300" %>
                                <% end %>
                            </td>
                            <td><%= user.name %></td>
                            <td><%= link_to "Show", user_path(@user), "btn btn-info" %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
        <div class="text-center">
            <%= paginate @users %>
        </div>
    </div>
</div>