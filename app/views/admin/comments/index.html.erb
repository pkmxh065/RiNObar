<div class="container">
  <div class="col-lg-12 d-flex mt-5">
    <h1>コメント管理一覧</h1>
  </div>
  
  <div class="col-lg-10 mt-3 py-2">
    <table class="table" style="border-collapse: collapse; width: 100%; text-align: left;">
      <thead>
        <tr class="text-center">
          <th>Title</th>
          <th>投稿者</th>
          <th>コメント内容</th>
          <th>投稿日時</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @comments.each do |comment| %>
          <tr class="text-center">
            <td style="vertical-align: middle;"><%= comment.novel.title %></td>
            <td style="vertical-align: middle;"><%= comment.user&.name || "退会済みユーザー" %></td>
            <td style="vertical-align: middle;"><%= truncate(comment.body, length: 50) %></td>
            <td style="vertical-align: middle;"><%= l comment.created_at, format: :short %></td>
            <td style="vertical-align: middle;">
              <%= link_to "詳　細", admin_comment_path(comment), class: "btn btn-info text-light" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="d-flex mt-3 gap-5">
    <%= paginate @comments %>
    <%= link_to "ダッシュボードへ戻る", admin_dashboard_path %>
  </div>
</div>