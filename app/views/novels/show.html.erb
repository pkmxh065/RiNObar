<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-12 mt-2 mb-2 text-center">
            <h1>Novels show</h1>
        </div>
    </div>
    <div class="row justify-content-between mt-4 w-100">
        <div class=" d-flex col-md-12 text-center">
            <div class="col-12 col-lg-5 text-center px-5">
                <table class="table-responsive mx-4" style="table-layout: fixed; width: 100%">
                    <thead>
                        <tr>
                            <th class="px-4" style="vertical-align: middle; width: 25%; height: 50px;">Title</th>
                            <th class="px-4" style="vertical-align: middle; width: 25%; height: 50px;">Genre</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-4" style="vertical-align: middle; width: 25%; height: 50px; white-space: nowrap;"><%= @novel.title %></td>
                            <td class="px-4" style="vertical-align: middle; width: 25%; height: 50px; white-space: nowrap;"><%= @novel.genre_main %><br><%= @novel.genre_sub %></td>
                        </tr>
                        <tr>
                            <th class="py-3 px-4">いいね</th>
                            <td class="py-3 px-4">
                                <%= render "novels/like", novel: @novel %>
                            </td>
                        </tr>
                        <tr>
                            <th class="py-3 px-4">評価</th>
                            <td class="py-3 px-4">☆</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-12 col-lg-5 text-center px-5">
                <h3 class="text-center mb-3">Posts user</h3>
                <table class="table-responsive" style="table-layout: fixed; width: 100%;">
                    <thead>
                        <tr>
                            <th >Image</th>
                            <th>Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <% if @novel.user.image.attached? %>
                                    <%= image_tag @novel.user.image, size: "200x200" %>
                                <% else %>
                                    <%= image_tag "no_image.png", size: "200x200" %>
                                <% end %>
                            </td>
                            <td><%= @novel.user.name %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row d-flex justify-content-center">
            <div class="col-lg-5 text-center">
                <table>
                    <tbody>
                        <tr>
                            <th class="px-3" style="vertical-align: middle; height: 100px;">Story</th>
                            <td class="px-3" style="vertical-align: middle; height: 100px;"><%= @novel.story %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-lg-5 text-center">
                <table>
                    <tbody>
                        <tr>
                            <th class="px-3" style="vertical-align: middle; height: 100px;">thought</th>
                            <td class="px-3" style="vertical-align: middle; height: 100px;"><%= @novel.thought %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-center mt-4 mb-5">
            <% if @current_user.present? && @current_user.id == @novel.user_id %>
                <%= link_to "編　集", edit_novel_path(@novel), class: "btn btn-secondary btn-lg" %>
                <%= link_to "削　除", @novel, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-lg" %>
            <% else %>
                <%= render "comments/edit" %>
            <% end %>
        </div>
    </div>
</div>