<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 mt-2 mb-2">
            <h1>Novel edit</h1>
        </div>
        <div class="col-md-6 mt-2">
            <%= form_with model: @novel do |novel| %>
                <div class="mb-4">
                    <%= novel.label :title, "タイトル", class: "form-label" %>
                    <%= novel.text_field :title, class: "form-control" %>
                </div>
                <div class="w-100 mb-4">
                    <%= novel.label :genre, "ジャンル", class: "form-label" %><br>
                    <div class="d-flex gap-2 w-100">
                        <%= novel.select :genre, [
                            ["異世界", "異世界"],
                            ["ラブコメ", "ラブコメ"],
                            ["バトル","バトル"],
                            ["ミステリー","ミステリー"],
                            ["その他","その他"]
                        ], {}, { class: "form-select w-50" } %>
                        <%= novel.select :genre, [
                            ["ファンタジー","ファンタジー"],
                            ["転生","転生"],
                            ["学園","学園"],
                            ["日常","日常"],
                            ["SF","SF"],
                            ["アクション","アクション"],
                            ["サスペンス","サスペンス"],
                            ["ホラー","ホラー"],
                            ["歴史・時代","歴史・時代"],
                            ["その他","その他"]
                        ], {}, { class:"form-select w-50" } %>
                    </div>
                </div>
                <div class="mb-4">
                    <%= novel.label :story, "ストーリー", class: "form-label" %>
                    <%= novel.text_area :story, class: "form-control" %>
                </div>
                <div class="mb-4">
                    <%= novel.label :thought, "感想", class: "form-label" %>
                    <%= novel.text_area :thought, class: "form-control" %>
                </div>
            <% end %>
        </div>
    </div>
</div>