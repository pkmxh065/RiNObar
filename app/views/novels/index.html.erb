<div class="container">
    <div class="row d-flex justify-content-center mt-5">
        <div class="col-12 mt-2 mb-2">
            <h1>Novels index</h1>
        </div>
        <div class="col-md-12 mt-2">
            <table class="table w-100 table-hover">
                <thead>
                    <tr>
                        <th class="px-4" style="text-align: center;">Title</th>
                        <th class="px-4" style="text-align: center;">Genre</th>
                        <th class="px-4" style="text-align: center;">User</th>
                        <th class="px-4" style="text-align: center;">いいね</th>
                        <th class="px-4" style="text-align: center;">Comment</th>
                        <th class="px-4" style="text-align: center;"></th>
                    </tr>
                </thead>
                <tbody>
                    <% @novels.each do |novel| %>
                        <tr class="align-middle">
                            <td class="px-4" style="text-align: center; white-space: nowrap;"><%= novel.title %></td>
                            <td class="px-4" style="text-align: center; white-space: nowrap;"><%= novel.genre_main %>／<%= novel.genre_sub %></td>
                            <td class="px-4" style="text-align: center; white-space: nowrap;"><%= novel.user.name %></td>
                            <td class="px-4" style="text-align: center; white-space: nowrap;">
                                <%= render "novels/like", novel: novel %>
                            </td>
                            <td class="px-4" style="text-align: center; white-space: nowrap;"><%= novel.comments.count %></td>
                            <td class="px-4" style="text-align: center; white-space: nowrap;"><%= link_to "詳　細", novel_path(novel), class: "btn btn-info text-light" %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    </div>
</div>
