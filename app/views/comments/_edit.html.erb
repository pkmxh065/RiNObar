<div class="col-12 d-flex">
    <div class="col-lg-4 px-3">
        <table class="table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Comment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% @comments.each do |comment| %>
                    <tr>
                        <td style="vertical-align: middle;">
                            <%= link_to user_path(comment.user) do %>
                                <% if comment.user.image.attached? %>
                                    <%= image_tag comment.user.image, size: "50x50" %><br>
                                <% else %>
                                    <%= image_tag "no_image.png", size: "50x50" %><br>
                                <% end %>
                                <%= comment.user.name %>
                            <% end %>
                        </td>
                        <td style="vertical-align: middle;"><%= comment.body %></td>
                        <td style="vertical-align: middle;">
                            <% if @current_user.present? && @current_user.id == comment.user_id %>
                                <%= button_to "削　除", novel_comment_path(@novel, comment), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger p-2" %>
                            <% else %>
                                コメント数：<%= @novel.comments.count %>
                            <% end %>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
    <div class="col-lg-6 px-3">
        <%=  form_with(model: [@novel, @comment], local: true) do |f| %>
            <%= f.label :body, "Comment New" %><br>
            <%= f.text_area :body, row: 3, class: "mt-1 w-100" %><br>
            <%= f.submit "投　稿" %>
        <% end %>
    </div>
</div>